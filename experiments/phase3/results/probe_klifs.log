        /bioactivity_list_id   [get]
        /bioactivity_list_pdb   [get]
        /drug_list   [get]
        /interactions_get_IFP   [get]
        /interactions_get_types   [get]
        /interactions_match_residues   [get]
        /kinase_ID   [get]
        /kinase_families   [get]
        /kinase_groups   [get]
        /kinase_information   [get]
        /kinase_names   [get]
        /ligands_list   [get]
        /ligands_list_structures   [get]
        /structure_conformation   [get]
        /structure_get_complex   [get]
        /structure_get_ligand   [get]
